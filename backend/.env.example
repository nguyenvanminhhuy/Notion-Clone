# Environment variable overrides for docker-compose
# Copy this file to .env and fill in real values before running docker-compose up

# PostgreSQL password
DB_PASSWORD=change_me_strong_db_password

# JWT signing secret — must be at least 32 characters
JWT_SECRET=CHANGE_ME_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS

# CORS allowed origin (your frontend URL)
CORS_ORIGIN=http://localhost:3000
